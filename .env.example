# Copy to .env on the server and fill in. Never commit .env.
APP_HOST=rag.bmctiernan.com
APP_ORIGIN=https://rag.bmctiernan.com
# 48+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Free key from https://console.groq.com/keys. Without it the app shows passages only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Signup stays closed on the hosted demo; reviewers use the demo account.
APP_ALLOW_SIGNUP=0
TRAEFIK_NETWORK=hosting-web
